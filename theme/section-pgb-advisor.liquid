{%- comment -%}
  PGB Beauty Advisor - AI chat bubble. Turn on/off, name it and set the backend URL in the theme editor
  (Overlay group > PGB Beauty Advisor). Nothing is loaded until a shopper taps the bubble.
  Promo bar + shortcut buttons inside the chat are edited here too (no code needed).
  If the new settings were never saved, the defaults below / in pgb-advisor.js are used.
{%- endcomment -%}
{%- liquid
  assign show = section.settings.enabled
  if section.settings.api_url == blank or request.page_type == 'password'
    assign show = false
  endif
  if section.settings.hide_on_home and request.page_type == 'index'
    assign show = false
  endif
  if section.settings.hide_on_cart and request.page_type == 'cart'
    assign show = false
  endif
  if section.settings.only_product_collection
    unless request.page_type == 'product' or request.page_type == 'collection'
      assign show = false
    endunless
  endif

  assign promo_text = section.settings.promo_text | default: '🪔 Diwali Gift Packs — Shop now'
  assign promo_url = section.settings.promo_url | default: '/collections/festive-gift-packs'
  assign quick_links = section.settings.quick_links
  assign nudge_text = section.settings.nudge_text | default: "Diwali gifts & up to 60% off — ask me ✨"
  if section.settings.promo_off
    assign promo_text = ''
  endif
-%}
{%- if show -%}
  {%- render 'pgb-advisor',
    api: section.settings.api_url,
    name: section.settings.assistant_name,
    promo_text: promo_text,
    promo_url: promo_url,
    quick_links: quick_links,
    nudge_text: nudge_text
  -%}
  <style>
    /* keep the chat button above the product page sticky Add to Cart bar (snippets/sticky-atc-bar.liquid) */
    body:has(#pgb-sticky-bar) #pgb-adv-launch{bottom:calc(var(--pgb-adv-sticky,120px) + env(safe-area-inset-bottom))!important}
  </style>
{%- endif -%}

{% schema %}
{
  "name": "PGB Beauty Advisor",
  "class": "pgb-advisor-section",
  "enabled_on": { "groups": ["custom.overlay"] },
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show AI beauty advisor", "default": true },
    { "type": "text", "id": "assistant_name", "label": "Assistant name", "default": "Pari" },
    { "type": "text", "id": "api_url", "label": "Advisor backend URL", "info": "Your Render service URL, e.g. https://pgb-advisor.onrender.com" },
    { "type": "checkbox", "id": "hide_on_home", "label": "Hide on home page", "default": true },
    { "type": "checkbox", "id": "hide_on_cart", "label": "Hide on cart page", "default": true },
    { "type": "checkbox", "id": "only_product_collection", "label": "Show only on product and collection pages", "default": true },
    { "type": "header", "content": "Promo bar (top of the chat)" },
    { "type": "checkbox", "id": "promo_off", "label": "Hide promo bar", "default": false },
    { "type": "text", "id": "promo_text", "label": "Promo bar text", "default": "🪔 Diwali Gift Packs — Shop now" },
    { "type": "text", "id": "promo_url", "label": "Promo bar link", "default": "/collections/festive-gift-packs", "info": "A store path like /collections/festive-gift-packs" },
    { "type": "header", "content": "Shortcut buttons" },
    { "type": "textarea", "id": "quick_links", "label": "Shortcut buttons (one per line)", "default": "60% OFF | deals:60\n50% OFF | deals:50-59\nBuy 3 @ ₹999 | /collections/sale\nOffers & coupons | ask\nBestsellers | /collections/bestsellers", "info": "Format: Label | /collections/handle. Use \"ask\" to make Pari answer the label, or \"deals:60\" / \"deals:50-59\" to show in-stock products at that % off." },
    { "type": "text", "id": "nudge_text", "label": "\"Hi\" bubble text", "default": "Diwali gifts & up to 60% off — ask me ✨" }
  ]
}
{% endschema %}
